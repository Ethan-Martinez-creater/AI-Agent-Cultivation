{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "noEmit": true,
    "allowJs": true,
    "checkJs": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "types": ["node"],
    "noUncheckedIndexedAccess": true
  },
  "include": ["controller.mjs", "snapshots.mjs", "types.d.ts"]
}
